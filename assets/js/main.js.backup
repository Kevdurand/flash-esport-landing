/* ==========================================================================
   Flash eSport — formulaire de liste d'attente
   Validation de l'adresse, message d'erreur, état de confirmation.
   Le branchement Mailerlite se fait dans la fonction d'envoi ci-dessous.
   ========================================================================== */

(function () {
  'use strict';

  var form    = document.getElementById('waitlist-form');
  var input   = document.getElementById('email');
  var button  = document.getElementById('submit-btn');
  var label   = document.getElementById('btn-label');
  var msg     = document.getElementById('form-msg');
  var success = document.getElementById('success');

  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i;

  /* Place le curseur dans le champ.
     preventScroll est important sur mobile : sans lui, Safari fait défiler
     la page pour « bien » montrer le champ et éjecte le haut de la page.
     L'appel est protégé car les très vieux navigateurs ignorent l'option. */
  function focusField() {
    try { input.focus({ preventScroll: true }); }
    catch (err) { input.focus(); }
  }

  /* Le bouton du bas de page remonte en haut de la page (le lien s'en charge)
     et fait clignoter le champ une fois pour indiquer où écrire.

     On ne place volontairement PAS le curseur ici : sur iOS, ouvrir le clavier
     force Safari à faire défiler la page pour dégager le champ, ce qui repousse
     le logo et le titre hors de l'écran. L'utilisateur touche le champ lui-même,
     et à ce moment-là le décalage est attendu. */
  var ctaBottom = document.getElementById('cta-bottom');
  if (ctaBottom) {
    ctaBottom.addEventListener('click', function () {
      if (form.classList.contains('is-done')) return;   // déjà inscrit : on ne relance rien
      setTimeout(function () {
        input.classList.remove('is-pointed');
        void input.offsetWidth;                         // force le redémarrage de l'animation
        input.classList.add('is-pointed');
      }, 480);                                          // une fois le défilement terminé
    });
  }

  function setError(text) {
    msg.textContent = text;
    input.setAttribute('aria-invalid', text ? 'true' : 'false');
  }

  input.addEventListener('input', function () {
    if (msg.textContent) setError('');
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    var email = input.value.trim();

    /* On donne le focus AVANT d'écrire le message d'erreur.
       Dans l'autre sens, la modification du DOM intervient entre le geste de
       l'utilisateur et le focus, et iOS ouvre alors le clavier sans que le
       champ soit réellement actif : il faut retaper dessus pour écrire. */
    if (!email)                { focusField(); setError('Il manque ton adresse email.'); return; }
    if (!EMAIL_RE.test(email)) { focusField(); setError('Cette adresse ne semble pas valide.'); return; }

    setError('');
    button.disabled = true;
    label.textContent = 'Envoi…';

    /* ==========================================================
       >>> BRANCHER MAILERLITE ICI <<<

       Deux façons de faire, au choix.

       ----------------------------------------------------------
       OPTION A — API Mailerlite (recommandé : garde ce design)
       ----------------------------------------------------------
       Dans Mailerlite : Formulaires > Formulaires embarqués > crée
       ton formulaire, puis récupère l'URL d'action « embedded form »
       (elle ressemble à https://assets.mailerlite.com/jsonp/XXXXXX/forms/YYYYYY/subscribe).
       Colle-la dans MAILERLITE_URL ci-dessous et décommente le bloc.

       var MAILERLITE_URL = 'https://assets.mailerlite.com/jsonp/XXXXXX/forms/YYYYYY/subscribe';

       var data = new FormData();
       data.append('fields[email]', email);
       data.append('ml-submit', '1');
       data.append('anticsrf', 'true');

       fetch(MAILERLITE_URL, { method: 'POST', body: data })
         .then(function (r) { return r.json(); })
         .then(function (res) {
           if (res && res.success) { showSuccess(); }
           else { fail("Une erreur est survenue. Réessaie dans un instant."); }
         })
         .catch(function () { fail("Connexion impossible. Vérifie ton réseau."); });

       return;   // <- garde ce return : il désactive la simulation plus bas

       ----------------------------------------------------------
       OPTION B — Formulaire Mailerlite natif (le plus simple)
       ----------------------------------------------------------
       Remplace l'attribut du <form> par :
           <form action="TON_URL_MAILERLITE" method="post">
       supprime le e.preventDefault() en haut de cette fonction,
       et Mailerlite gère l'envoi + la page de confirmation.
       (Tu perds l'animation de confirmation intégrée ci-dessous.)
       ========================================================== */

    /* --- Simulation (à supprimer une fois Mailerlite branché) --- */
    setTimeout(showSuccess, 850);
  });

  function showSuccess() {
    form.classList.add('is-done');
    success.classList.add('is-visible');
  }

  function fail(text) {
    button.disabled = false;
    label.textContent = 'Rejoins la liste';
    setError(text);
  }
})();
